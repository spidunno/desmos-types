{
  "name": "@spidunno/desmos-types",
  "version": "1.13.9",
  "description": "TypeScript type definitions for the Desmos API v1.13",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./internals": {
      "types": "./internals/index.d.ts"
    },
    "./module": {
      "types": "./module/index.d.ts"
    },
    "./module/internals": {
      "types": "./module/internals.d.ts"
    }
  },
  "files": [
    "index.d.ts",
    "types/**/*.d.ts",
    "internals/**/*.d.ts",
    "module/*.d.ts"
  ],
  "scripts": {
    "test": "npm run build:module && tsc -p tsconfig.json && tsc -p tsconfig.internals.json && tsc -p tsconfig.module.json",
    "build:module": "node scripts/build-module-types.cjs",
    "prepack": "npm run build:module",
    "generate:internals": "node scripts/extract-internals.cjs",
    "snapshot:sketches": "node scripts/snapshot-sketches.cjs",
    "bundle-info": "node scripts/bundle-info.cjs",
    "update:bundle": "node scripts/update-bundle.mjs"
  },
  "keywords": [
    "desmos",
    "typescript",
    "types",
    "calculator"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spidunno/desmos-types.git",
    "directory": "packages/desmos-types"
  },
  "devDependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "jsdom": "^24.1.3"
  },
  "desmos": {
    "version": "v1.13-prerelease",
    "commit": "7f0bcd732b59def63b568d6e527e004258e53995"
  }
}
